# Copy to .env for local development. Placeholders only — never commit real secrets.
APP_ENV=development
APP_NAME=ai-lms
LOG_LEVEL=INFO

# Local PostgreSQL (matches compose.yaml defaults).
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms
POSTGRES_DB=lms
POSTGRES_PORT=5434
DATABASE_URL=postgresql+psycopg://lms:lms@localhost:5434/lms

# Ports exposed on the host.
API_PORT=8001
WEB_PORT=3001

# URL the web server uses to reach the API (server-side only).
API_INTERNAL_URL=http://localhost:8001

# Reserved for later phases (leave blank until configured and approved).
REDIS_URL=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Authentication provider.
#   disabled    (default) deny-by-default; protected endpoints return 401.
#   development TEMPORARY local-only access without sign-in. Refused unless
#               APP_ENV=development. Never use outside your own machine.
#               See docs/SECURITY.md ("Temporary development access mode").
AUTH_PROVIDER=disabled
# Roles granted in development mode (comma-separated). system_admin is not allowed.
DEV_ACCESS_ROLES=learning_admin

# AI provider settings — configure only after security/legal approval.
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local AI & Media Tooling
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
PIPER_BINARY_PATH=piper
PIPER_VOICE_MODEL=
FFMPEG_BINARY_PATH=ffmpeg

# Private object storage — use workload identity / secret manager in production.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
